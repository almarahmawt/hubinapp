{
    "plugins": [
        "@prettier/plugin-php",
        "@shufo/prettier-plugin-blade"
    ],
    "overrides": [
        {
            "files": ["*.blade.php"],
            "options": {
                "parser": "blade",
                "tabWidth": 4
            }
        },
        {
      "files": "*.php",
      "options": {
        "parser": "php",
        "tabWidth": 4,
        "singleQuote": true
      }
    }
    ]

}
